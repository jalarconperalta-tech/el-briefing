{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Índice de ediciones de El Briefing",
  "type": "object",
  "additionalProperties": false,
  "required": ["editions"],
  "properties": {
    "editions": {
      "type": "array",
      "description": "De más reciente a más antigua.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "stories", "opportunities", "headlines"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "stories": { "type": "integer", "minimum": 1 },
          "opportunities": { "type": "integer", "minimum": 0 },
          "headlines": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 10 } },
          "sample": { "type": "boolean" }
        }
      }
    }
  }
}
